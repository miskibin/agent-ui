{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-ui-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "agent-ui-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "chat-components-docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "../chat-components",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
