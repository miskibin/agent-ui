{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent UI",
  "version": "0.3.1",
  "identifier": "com.miskibin.agent-ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/prepare-desktop.mjs",
    "frontendDist": "./splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent UI",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#0b0b0d",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/miskibin/agent-ui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RjYzQzAyQzlBNUJCMjQKUldRa3U2WEpBanoyTnpmWXZUS0tBT2gxYVl4eFVxNFJWSjh4ckJIckwvVFBPTGFNU2JTMVFpcnAK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Local-first chat UI for coding agents",
    "longDescription": "Agent UI is a local-first desktop chat client for coding agents. It bundles its own Node.js runtime and runs the app server on 127.0.0.1.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["resources/app"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
